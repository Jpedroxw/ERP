<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ProjetoJP.Master</RootNamespace>
    <AssemblyName>ProjetoJP-Master</AssemblyName>
    <AssemblyTitle>Projeto JP Master</AssemblyTitle>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <ApplicationIcon>master.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="master.ico" LogicalName="ProjetoJP.Master.master.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProjetoJP.Shared\ProjetoJP.Shared.csproj" />
    <ProjectReference Include="..\ProjetoJP.Controles\ProjetoJP.Controles.csproj" />
  </ItemGroup>

</Project>
